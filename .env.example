# Copy this file to .env and fill it in. .env is gitignored -- nothing here
# ever reaches GitHub.

# ── Required ──────────────────────────────────────────────────────────────
# Your LeetCode browser session cookie. scripts/import_leetcode.py uses it to
# read your own submission history (LeetCode has no public API for this).
#
# To get it:
#   1. Log in at leetcode.com
#   2. F12 -> Application -> Cookies -> https://leetcode.com
#   3. Copy the LEETCODE_SESSION value (a long token)
#
# This cookie is equivalent to your login. Keep it out of git, and log out of
# LeetCode to invalidate it if it ever leaks.
LEETCODE_SESSION=

# ── Optional: only needed if Cloudflare starts blocking the script ────────
# Sent with POST requests. Harmless to set.
CSRF_TOKEN=

# Cloudflare's "not a bot" cookie. It is bound to the exact User-Agent AND IP
# address that earned it, so a mismatch is WORSE than leaving it blank. Only
# set this if you get a Cloudflare challenge, and set USER_AGENT to match your
# real browser exactly (check at whatismybrowser.com).
CF_CLEARANCE=
USER_AGENT=
