# Secrets -- LEETCODE_SESSION lives here. Never commit this.
.env
.env.*
!.env.example

# Inbox working files.
# Everything staged here is raw, unexplained code waiting to be processed.
# It must never reach a commit -- the pipeline deletes each file only once it
# has been explained and filed into LeetCode/ or CodeChef/. Without this, a
# `git add -A` during a failed run would commit the bare solution with no
# write-up, which is exactly what this repo exists to avoid.
inbox/*
!inbox/README.md

# Nightly sync logs and local authentication alerts
sync_status/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
