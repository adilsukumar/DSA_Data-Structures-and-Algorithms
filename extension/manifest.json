{
  "manifest_version": 3,
  "name": "DSA Submission Sync",
  "version": "1.0.0",
  "description": "Sync LeetCode and CodeChef submissions to the local DSA repository.",
  "key": "",
  "permissions": ["alarms", "cookies", "nativeMessaging", "storage"],
  "host_permissions": ["https://leetcode.com/*", "https://www.leetcode.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "DSA Submission Sync" }
}
